html style close marker missing');
  app=app.replace('\n</style>',css+'\n</style>');
}
const oldTransfer=read(`${payload}/old-transfer.html`).trimEnd();
const newTransfer=read(`${payload}/new-transfer.html`).trimEnd();
if(!app.includes(newTransfer)){
  if(!app.includes(oldTransfer)) throw new Error('Current Transfers shell marker missing');
  app=app.replace(oldTransfer,newTransfer);
}
write('app.html',app);

replaceOnce('src/storage.mjs',
  "    useManual: $('useManual').checked,\n    useUstat: $('useUstat').checked\n",
  "    useManual: $('useManual').checked,\n    useUstat: $('useUstat').checked,\n    transferHorizon: Number($('trHorizon')?.value || 6),\n    transferResults: Number($('trTop')?.value || 8)\n");

let views=read('src/ui/views.mjs');
const transferStart="/* ---------------------------------------------------------------------\n   VIEW — TRANSFER PLANNER\n   --------------------------------------------------------------------- */";
const transferEnd="/* ---------------------------------------------------------------------\n   VIEW — MINI-LEAGUE";
if(views.includes(transferStart)){
  const start=views.indexOf(transferStart);
  const end=views.indexOf(transferEnd,start);
  if(end<0) throw new Error('Legacy transfer renderer end marker missing');
  views=views.slice(0,start)+views.slice(end);
}
views=views.replace("['trHorizon','trTop'].forEach(id => $(id).addEventListener('input', debounce(renderTransfers, 180)));\n",'');
const cfgMarker="    if(cfg.bank != null) $('bankIn').value = cfg.bank;\n";
if(!views.includes('cfg.transferHorizon')){
  if(!views.includes(cfgMarker)) throw new Error('Transfer config load marker missing');
  views=views.replace(cfgMarker,cfgMarker+
    "    if(cfg.transferHorizon != null) $('trHorizon').value = String(cfg.transferHorizon);\n"+
    "    if(cfg.transferResults != null) $('trTop').value = String(cfg.transferResults);\n");
}
write('src/ui/views.mjs',views);


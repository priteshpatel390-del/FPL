mkdirSync('scripts/teamsheet-2.0.3-payload',{recursive:true});
for(const [name,encoded] of Object.entries(embeddedPayloads)){
  writeFileSync(`scripts/teamsheet-2.0.3-payload/${name}`,Buffer.from(encoded,'base64'));
}

const payload='scripts/teamsheet-2.0.3-payload';
const read=path=>readFileSync(path,'utf8');
const write=(path,value)=>writeFileSync(path,value);
const replaceOnce=(path,before,after)=>{
  const source=read(path);
  if(!source.includes(before)) throw new Error(`Expected marker missing in ${path}`);
  write(path,source.replace(before,after));
};
const appendOnce=(path,marker,block)=>{
  const source=read(path);
  if(source.includes(marker)) return;
  write(path,source.trimEnd()+`\n\n${block.trim()}\n`);
};
const insertAfterHeading=(path,marker,block)=>{
  const source=read(path);
  if(source.includes(marker)) return;
  const match=source.match(/^# .+$/m);
  if(!match) throw new Error(`Heading missing in ${path}`);
  const at=match.index+match[0].length;
  write(path,source.slice(0,at)+`\n\n${block.trim()}\n`+source.slice(at).replace(/^\n+/,''));
};

copyFileSync(`${payload}/transfer-optimiser-view.mjs`,'src/ui/transfer-optimiser-view.mjs');
copyFileSync(`${payload}/transfer-optimiser-view.test.mjs`,'tests/transfer-optimiser-view.test.mjs');
copyFileSync(`${payload}/TEAMSHEET2-ITEM3.md`,'docs/TEAMSHEET2-ITEM3.md');

let app=read('app.html');
const css=read(`${payload}/transfers.css`);

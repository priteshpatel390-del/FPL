{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamsheet-data-platform",
  "main": "data-platform-rpc.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "DATA_S2_SEASON": "2026-27" },
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [{ "binding": "TEAMSHEET_DATA_DB", "database_name": "teamsheet-data", "migrations_dir": "migrations" }]
}

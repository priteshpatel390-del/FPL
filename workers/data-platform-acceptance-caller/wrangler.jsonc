{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamsheet-data-platform-acceptance-caller",
  "main": "data-platform-acceptance-caller.mjs",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "services": [{
    "binding": "DATA_PLATFORM_READ",
    "service": "teamsheet-data-platform",
    "entrypoint": "DataPlatformReadEntrypoint"
  }]
}

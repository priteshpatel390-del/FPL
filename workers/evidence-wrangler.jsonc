{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teamsheet-evidence-archive",
  "main": "evidence-archive.mjs",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://priteshpatel390-del.github.io,https://app.fpltsheet.co.uk",
    "ALLOW_UNDERSTAT_RETENTION": "false",
    "ALLOW_ODDS_RETENTION": "false",
    "MAX_REQUESTS_PER_MINUTE": "30"
  },
  "d1_databases": [
    {
      "binding": "EVIDENCE_DB",
      "migrations_dir": "evidence-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE_BUCKET"
    }
  ]
}
